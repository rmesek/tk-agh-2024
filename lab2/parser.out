Grammar:

Rule 0     S' -> program
Rule 1     program -> instructions_opt
Rule 2     instructions_opt -> <empty>
Rule 3     instructions_opt -> instructions_opt instruction
Rule 4     instructions -> instruction
Rule 5     instructions -> instructions instruction
Rule 6     instruction -> RETURN expression ;
Rule 7     instruction -> CONTINUE ;
Rule 8     instruction -> BREAK ;
Rule 9     instruction -> print_statement
Rule 10    instruction -> assignment
Rule 11    instruction -> for_statement
Rule 12    instruction -> while_statement
Rule 13    instruction -> if_statement
Rule 14    instruction -> { instructions }
Rule 15    instruction -> ;
Rule 16    if_statement -> IF ( condition ) instruction  [precedence=nonassoc, level=1]
Rule 17    if_statement -> IF ( condition ) instruction ELSE instruction  [precedence=nonassoc, level=2]
Rule 18    while_statement -> WHILE ( condition ) instruction
Rule 19    for_statement -> FOR ID = range : range instruction
Rule 20    range -> INTNUM
Rule 21    range -> ID
Rule 22    print_statement -> PRINT print_list ;
Rule 23    print_list -> expression
Rule 24    print_list -> print_list , expression
Rule 25    expression -> expression DOTDIV expression  [precedence=left, level=5]
Rule 26    expression -> expression DOTMUL expression  [precedence=left, level=5]
Rule 27    expression -> expression DOTSUB expression  [precedence=left, level=4]
Rule 28    expression -> expression DOTADD expression  [precedence=left, level=4]
Rule 29    expression -> expression / expression  [precedence=left, level=5]
Rule 30    expression -> expression * expression  [precedence=left, level=5]
Rule 31    expression -> expression - expression  [precedence=left, level=4]
Rule 32    expression -> expression + expression  [precedence=left, level=4]
Rule 33    expression -> ( expression )
Rule 34    expression -> expression '  [precedence=nonassoc, level=6]
Rule 35    expression -> [ matrix_rows ]
Rule 36    expression -> - expression  [precedence=left, level=4]
Rule 37    expression -> matrix_access
Rule 38    expression -> matrix_function
Rule 39    expression -> condition
Rule 40    expression -> assignment
Rule 41    expression -> STRING
Rule 42    expression -> ID
Rule 43    expression -> FLOATNUM
Rule 44    expression -> INTNUM
Rule 45    assignment -> variable DIVASSIGN expression ;
Rule 46    assignment -> variable MULASSIGN expression ;
Rule 47    assignment -> variable SUBASSIGN expression ;
Rule 48    assignment -> variable ADDASSIGN expression ;
Rule 49    assignment -> variable = expression ;
Rule 50    variable -> matrix_access
Rule 51    variable -> ID
Rule 52    condition -> expression NE expression  [precedence=nonassoc, level=3]
Rule 53    condition -> expression EQ expression  [precedence=nonassoc, level=3]
Rule 54    condition -> expression GE expression  [precedence=nonassoc, level=3]
Rule 55    condition -> expression LE expression  [precedence=nonassoc, level=3]
Rule 56    condition -> expression > expression  [precedence=nonassoc, level=3]
Rule 57    condition -> expression < expression  [precedence=nonassoc, level=3]
Rule 58    matrix_function -> EYE ( INTNUM )
Rule 59    matrix_function -> ONES ( INTNUM )
Rule 60    matrix_function -> ZEROS ( INTNUM )
Rule 61    matrix_access -> ID [ index_list ]
Rule 62    index_list -> index
Rule 63    index_list -> index_list , index
Rule 64    index -> INTNUM
Rule 65    index -> ID
Rule 66    matrix_rows -> matrix_row
Rule 67    matrix_rows -> matrix_rows , matrix_row
Rule 68    matrix_row -> [ number_list ]
Rule 69    number_list -> signed_number
Rule 70    number_list -> number_list , signed_number
Rule 71    signed_number -> - number  [precedence=left, level=4]
Rule 72    signed_number -> number
Rule 73    number -> INTNUM
Rule 74    number -> FLOATNUM

