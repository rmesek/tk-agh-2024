Grammar:

Rule 0     S' -> program
Rule 1     program -> instructions_opt
Rule 2     instructions_opt -> instruction
Rule 3     instructions_opt -> <empty>
Rule 4     instructions_opt -> instructions_opt instruction
Rule 5     instructions -> instruction
Rule 6     instructions -> instructions instruction
Rule 7     instruction -> RETURN expression ;
Rule 8     instruction -> CONTINUE ;
Rule 9     instruction -> BREAK ;
Rule 10    instruction -> print_statement
Rule 11    instruction -> assignment
Rule 12    instruction -> for_statement
Rule 13    instruction -> while_statement
Rule 14    instruction -> if_statement
Rule 15    instruction -> { instructions }
Rule 16    instruction -> ;
Rule 17    if_statement -> IF ( condition ) instruction  [precedence=nonassoc, level=1]
Rule 18    if_statement -> IF ( condition ) instruction ELSE instruction  [precedence=nonassoc, level=2]
Rule 19    while_statement -> WHILE ( condition ) instruction
Rule 20    for_statement -> FOR ID = range instruction
Rule 21    range -> expression : expression
Rule 22    print_statement -> PRINT print_list ;
Rule 23    print_list -> expression
Rule 24    print_list -> print_list , expression
Rule 25    expression -> matrix_function
Rule 26    expression -> variable
Rule 27    expression -> STRING
Rule 28    expression -> FLOATNUM
Rule 29    expression -> INTNUM
Rule 30    expression -> ( expression )
Rule 31    expression -> expression '  [precedence=nonassoc, level=6]
Rule 32    expression -> [ matrix_rows ]
Rule 33    expression -> - expression  [precedence=left, level=4]
Rule 34    expression -> expression DOTDIV expression  [precedence=left, level=5]
Rule 35    expression -> expression DOTMUL expression  [precedence=left, level=5]
Rule 36    expression -> expression DOTSUB expression  [precedence=left, level=4]
Rule 37    expression -> expression DOTADD expression  [precedence=left, level=4]
Rule 38    expression -> expression / expression  [precedence=left, level=5]
Rule 39    expression -> expression * expression  [precedence=left, level=5]
Rule 40    expression -> expression - expression  [precedence=left, level=4]
Rule 41    expression -> expression + expression  [precedence=left, level=4]
Rule 42    variable -> matrix_access
Rule 43    variable -> ID
Rule 44    assignment -> variable DIVASSIGN expression ;
Rule 45    assignment -> variable MULASSIGN expression ;
Rule 46    assignment -> variable SUBASSIGN expression ;
Rule 47    assignment -> variable ADDASSIGN expression ;
Rule 48    assignment -> variable = expression ;
Rule 49    matrix_function -> EYE ( INTNUM )
Rule 50    matrix_function -> ONES ( INTNUM )
Rule 51    matrix_function -> ZEROS ( INTNUM )
Rule 52    matrix_access -> ID [ index_list ]
Rule 53    index_list -> index
Rule 54    index_list -> index_list , index
Rule 55    index -> expression
Rule 56    matrix_rows -> matrix_row
Rule 57    matrix_rows -> matrix_rows ; matrix_row
Rule 58    matrix_row -> [ number_list ]
Rule 59    number_list -> signed_number
Rule 60    number_list -> number_list , signed_number
Rule 61    signed_number -> - number  [precedence=left, level=4]
Rule 62    signed_number -> number
Rule 63    number -> INTNUM
Rule 64    number -> FLOATNUM
Rule 65    condition -> expression NE expression  [precedence=nonassoc, level=3]
Rule 66    condition -> expression EQ expression  [precedence=nonassoc, level=3]
Rule 67    condition -> expression GE expression  [precedence=nonassoc, level=3]
Rule 68    condition -> expression LE expression  [precedence=nonassoc, level=3]
Rule 69    condition -> expression > expression  [precedence=nonassoc, level=3]
Rule 70    condition -> expression < expression  [precedence=nonassoc, level=3]

